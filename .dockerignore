# Stage 1: Base runtime environment (Lightweight, for running the app)
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER app
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

# Stage 2: Build environment (Contains full SDK for compiling)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copy only the project file first to cache NuGet dependencies
COPY ["RaceDayFrontend.csproj", "."]
RUN dotnet restore "./RaceDayFrontend.csproj"

# Copy the rest of the code and build
COPY . .
WORKDIR "/src/."
RUN dotnet build "./RaceDayFrontend.csproj" -c $BUILD_CONFIGURATION -o /app/build

# Stage 3: Publish (Optimizes the output for production)
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./RaceDayFrontend.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# Stage 4: Final output (Copies compiled code into the lightweight base image)
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "RaceDayFrontend.dll"]