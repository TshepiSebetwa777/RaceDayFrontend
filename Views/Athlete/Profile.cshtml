@model RaceDayFrontend.Models.AthleteProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4 mb-5 max-w-700">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">⚙️ Profile Settings</h2>
        <p class="text-muted">Manage your personal details and upload your official race portrait.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data">

                <!-- Profile Picture Section -->
                <div class="text-center mb-5 pb-4 border-bottom">
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(Model.CurrentProfilePictureUrl))
                        {
                            <img src="@Model.CurrentProfilePictureUrl" alt="Profile" class="rounded-circle shadow object-fit-cover" style="width: 150px; height: 150px; border: 4px solid #fff;" />
                        }
                        else
                        {
                            <div class="rounded-circle shadow bg-light d-flex align-items-center justify-content-center text-primary" style="width: 150px; height: 150px; border: 4px solid #fff;">
                                <i class="bi bi-person-fill display-3"></i>
                            </div>
                        }
                        <label for="profileUpload" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-2 shadow cursor-pointer hover-lift" title="Upload new picture">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                        <!-- Hidden File Input for Azure Blob Upload -->
                        <input type="file" id="profileUpload" name="NewProfilePicture" class="d-none" accept="image/jpeg, image/png" onchange="previewImage(event)" />
                    </div>
                    <h5 class="fw-bold mb-1">Athlete Portrait</h5>
                    <p class="text-muted small mb-0">JPEG or PNG. Max size 2MB.</p>
                </div>

                <!-- Personal Information -->
                <h5 class="fw-bold mb-4">Personal Information</h5>
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control bg-light border-0" placeholder="First Name" />
                            <label asp-for="FirstName"></label>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control bg-light border-0" placeholder="Last Name" />
                            <label asp-for="LastName"></label>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .max-w-700 {
        max-width: 700px;
        margin-inline: auto;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .hover-lift:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease;
    }
</style>

<script>
    // Simple script to swap the image preview immediately upon selecting a file
    function previewImage(event) {
        var input = event.target;
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = input.previousElementSibling.previousElementSibling;
                if(img.tagName === 'IMG') {
                    img.src = e.target.result;
                } else {
                    // If it was the placeholder icon, replace it with an image tag
                    var container = img.parentElement;
                    img.outerHTML = '<img src="' + e.target.result + '" class="rounded-circle shadow object-fit-cover" style="width: 150px; height: 150px; border: 4px solid #fff;" />';
                }
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>