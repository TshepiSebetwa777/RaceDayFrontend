@model IEnumerable<RaceDayFrontend.Models.AthleteEventDto>
@{
    ViewData["Title"] = "Upcoming Races";
}

<div class="mb-5 mt-3 text-center">
    <h2 class="fw-bold text-primary display-5 mb-3">🏅 Find Your Next Challenge</h2>

    <!-- Filtering Options (Rubric Requirement) -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center max-w-700 mx-auto">
        <div class="input-group shadow-sm rounded-pill overflow-hidden">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 px-4 py-3" placeholder="Search by race name, location, or organiser...">
            <button type="submit" class="btn btn-primary px-4 fw-bold">Search</button>
            <a asp-action="Index" class="btn btn-light border-start px-4 d-flex align-items-center">Clear</a>
        </div>
    </form>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-light text-primary border border-primary rounded-pill px-3 py-2">
                                @item.RaceDate.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                        <h4 class="fw-bold mb-2">@item.Title</h4>
                        <p class="text-muted small mb-4 line-clamp-2">@item.Description</p>

                        <!-- FIX: This button now correctly routes to EventDetails -->
                        <a asp-action="EventDetails" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                            View Details & Enrol
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">No upcoming races found.</h4>
        </div>
    }
</div>

<style>
    .max-w-700 {
        max-width: 700px;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>