@model IEnumerable<RaceDayFrontend.Models.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-primary">🏷️ Categories: @ViewBag.EventTitle</h2>
    <a asp-action="ManageEvents" class="btn btn-outline-secondary rounded-pill px-4">Back to Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Add New Category Form -->
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white rounded-top-4">
                <h5 class="mb-0 py-2">➕ Add Category</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddCategory" asp-route-eventId="@ViewBag.EventId" asp-route-eventTitle="@ViewBag.EventTitle" method="post">

                    <div class="form-floating mb-3">
                        <input type="text" name="typeName" class="form-control bg-light border-0" required placeholder="e.g., Half Marathon" />
                        <label>Category Name</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="number" step="0.01" name="distanceKm" class="form-control bg-light border-0" required placeholder="21.1" />
                        <label>Distance (km)</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Save Category</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Existing Categories List -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">Category Name</th>
                        <th class="py-3 text-center">Distance (km)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold">@cat.TypeName</td>
                                <td class="py-3 text-center"><span class="badge bg-info text-dark rounded-pill px-3">@cat.DistanceKM km</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center py-5 text-muted">No categories added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>