@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay Athletics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    🏁 RaceDay Athletics
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Director" asp-action="Index">Director Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Director" asp-action="ManageEvents">Manage Events</a></li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Athlete" asp-action="Index">Athlete Portal</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Athlete" asp-action="MyResults">My Races</a></li>
                            <li class="nav-item"><a class="nav-link text-white" asp-controller="Athlete" asp-action="Profile">My Profile</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item align-self-center me-3">
                                <span class="text-light"><em>@userEmail</em></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-primary rounded-pill px-4 fw-bold" asp-controller="Account" asp-action="Logout">Sign Out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light rounded-pill px-4" asp-controller="Account" asp-action="Login">Athlete / Director Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>